# --- Neon Postgres ---------------------------------------------------------
# Neon の接続文字列（pooled endpoint 推奨）
DATABASE_URL=

# --- Auth.js ---------------------------------------------------------------
# openssl rand -base64 32  などで生成
AUTH_SECRET=
# Discord Developer Portal > Applications > OAuth2
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# --- 学籍番号 --------------------------------------------------------------
# 学籍番号を導出する HMAC 鍵。一度決めたら絶対に変更しない
# （変更すると発行済みの学籍番号と discord_hash の対応が全て壊れる）
# openssl rand -base64 48  などで生成
RGA_STUDENT_ID_SALT=

# --- 任意 ------------------------------------------------------------------
# 未参加者向け案内に表示する Discord 招待 URL。未設定ならボタンを出さない
NEXT_PUBLIC_DISCORD_INVITE_URL=
